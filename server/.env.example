PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hisabflow
# Use a long random string in production (32+ chars): openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-please-0000
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Lets a user switch plans without payment. Dev/demo only. Keep false in production.
ALLOW_PLAN_SWITCH=true
# AI insights: "rules" (built-in, no API needed) or "llm" (see src/services/insights/llm.js)
AI_PROVIDER=rules
LLM_API_KEY=
